<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lzcer.interfaceplatform.mapper.InterfaceMapper">
    <resultMap id="view" type="com.lzcer.interfaceplatform.model.interfacecatalog.InterfaceModels$InterfaceView"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="interface_code" javaType="java.lang.String"/><arg column="interface_name" javaType="java.lang.String"/><arg column="description" javaType="java.lang.String"/><arg column="source_system_id" javaType="java.lang.Long"/><arg column="source_system" javaType="java.lang.String"/><arg column="target_system_id" javaType="java.lang.Long"/><arg column="target_system" javaType="java.lang.String"/><arg column="http_method" javaType="java.lang.String"/><arg column="interface_path" javaType="java.lang.String"/><arg column="target_url" javaType="java.lang.String"/><arg column="connect_timeout_ms" javaType="java.lang.Integer"/><arg column="read_timeout_ms" javaType="java.lang.Integer"/><arg column="enabled" javaType="java.lang.Boolean"/><arg column="today_calls" javaType="java.lang.Long"/><arg column="success_rate" javaType="java.math.BigDecimal"/><arg column="avg_duration_ms" javaType="java.lang.Long"/><arg column="updated_at" javaType="java.time.LocalDateTime"/></constructor></resultMap>
    <resultMap id="systemOption" type="com.lzcer.interfaceplatform.model.interfacecatalog.InterfaceModels$SystemOption"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="system_code" javaType="java.lang.String"/><arg column="system_name" javaType="java.lang.String"/><arg column="base_url" javaType="java.lang.String"/><arg column="health_status" javaType="java.lang.String"/></constructor></resultMap>
    <resultMap id="route" type="com.lzcer.interfaceplatform.mapper.InterfaceMapper$RouteRow"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="interface_code" javaType="java.lang.String"/><arg column="interface_name" javaType="java.lang.String"/><arg column="target_system" javaType="java.lang.String"/><arg column="target_status" javaType="java.lang.String"/><arg column="target_url" javaType="java.lang.String"/><arg column="connect_timeout_ms" javaType="java.lang.Integer"/><arg column="read_timeout_ms" javaType="java.lang.Integer"/><arg column="http_method" javaType="java.lang.String"/><arg column="interface_path" javaType="java.lang.String"/></constructor></resultMap>
    <sql id="viewFrom">from ip_interface i join ip_system source_system on source_system.id=i.source_system_id join ip_system target_system on target_system.id=i.target_system_id left join ip_invocation_log l on l.interface_code=i.interface_code and l.route_type='HTTP' and l.call_time &gt;= current_date</sql>
    <sql id="viewSelect">i.id,i.interface_code,i.interface_name,i.description,i.source_system_id,source_system.system_name as source_system,i.target_system_id,target_system.system_name as target_system,i.http_method,i.interface_path,i.target_url,i.connect_timeout_ms,i.read_timeout_ms,i.enabled,i.updated_at,count(l.id) as today_calls,case when count(l.id)=0 then 0 else sum(case when l.call_status='SUCCESS' then 1 else 0 end)*100.0/count(l.id) end as success_rate,coalesce(avg(l.duration_ms),0) as avg_duration_ms</sql>
    <sql id="viewGroup">group by i.id,i.interface_code,i.interface_name,i.description,i.source_system_id,source_system.system_name,i.target_system_id,target_system.system_name,i.http_method,i.interface_path,i.target_url,i.connect_timeout_ms,i.read_timeout_ms,i.enabled,i.updated_at</sql>
    <select id="findAll" resultMap="view">select <include refid="viewSelect"/> <include refid="viewFrom"/> <include refid="viewGroup"/> order by i.updated_at desc</select>
    <select id="findById" resultMap="view">select <include refid="viewSelect"/> <include refid="viewFrom"/> where i.id=#{id} <include refid="viewGroup"/></select>
    <select id="findByCode" resultMap="view">select <include refid="viewSelect"/> <include refid="viewFrom"/> where i.interface_code=#{code} <include refid="viewGroup"/></select>
    <select id="findSystemOptions" resultMap="systemOption">select id,system_code,system_name,base_url,health_status from ip_system order by id</select>
    <select id="findSystemBaseUrl" resultType="String">select base_url from ip_system where id=#{id}</select>
    <sql id="routeColumns">i.id,i.interface_code,i.interface_name,i.target_url,i.http_method,i.interface_path,i.connect_timeout_ms,i.read_timeout_ms,target_system.system_name as target_system,target_system.health_status as target_status</sql>
    <select id="findEnabledByPathAndMethod" resultMap="route">select <include refid="routeColumns"/> from ip_interface i join ip_system target_system on target_system.id=i.target_system_id where i.interface_path=#{path} and i.http_method=#{method} and i.enabled=true</select>
    <select id="findRuntimeConfig" resultMap="route">select <include refid="routeColumns"/> from ip_interface i join ip_system target_system on target_system.id=i.target_system_id where i.id=#{id}</select>
    <insert id="insert">insert into ip_interface(interface_code,interface_name,description,source_system_id,target_system_id,http_method,interface_path,target_url,connect_timeout_ms,read_timeout_ms,enabled) values(#{code},#{name},#{description},#{sourceId},#{targetId},#{method},#{path},#{targetUrl},#{connectTimeout},#{readTimeout},#{enabled})</insert>
    <update id="update">update ip_interface set interface_code=#{code},interface_name=#{name},description=#{description},source_system_id=#{sourceId},target_system_id=#{targetId},http_method=#{method},interface_path=#{path},target_url=#{targetUrl},connect_timeout_ms=#{connectTimeout},read_timeout_ms=#{readTimeout},enabled=#{enabled},updated_at=current_timestamp where id=#{id}</update>
    <update id="updateEnabled">update ip_interface set enabled=#{enabled},updated_at=current_timestamp where id=#{id}</update>
    <delete id="delete">delete from ip_interface where id=#{id}</delete>
    <delete id="deleteHttpPermissions">delete from ip_client_permission where route_type='HTTP' and resource_code=#{code}</delete>
</mapper>
