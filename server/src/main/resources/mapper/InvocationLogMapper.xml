<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lzcer.interfaceplatform.mapper.InvocationLogMapper">
    <resultMap id="summary" type="com.lzcer.interfaceplatform.service.InvocationLogService$LogSummary">
        <constructor><arg column="trace_id" javaType="java.lang.String"/><arg column="route_type" javaType="java.lang.String"/><arg column="interface_code" javaType="java.lang.String"/><arg column="interface_name" javaType="java.lang.String"/><arg column="caller" javaType="java.lang.String"/><arg column="target_system" javaType="java.lang.String"/><arg column="request_method" javaType="java.lang.String"/><arg column="request_path" javaType="java.lang.String"/><arg column="call_status" javaType="java.lang.String"/><arg column="platform_code" javaType="java.lang.String"/><arg column="http_status" javaType="int"/><arg column="duration_ms" javaType="long"/><arg column="call_time" javaType="java.time.LocalDateTime"/></constructor>
    </resultMap>
    <resultMap id="detail" type="com.lzcer.interfaceplatform.service.InvocationLogService$LogDetail">
        <constructor><arg column="trace_id" javaType="java.lang.String"/><arg column="route_type" javaType="java.lang.String"/><arg column="interface_code" javaType="java.lang.String"/><arg column="interface_name" javaType="java.lang.String"/><arg column="caller" javaType="java.lang.String"/><arg column="target_system" javaType="java.lang.String"/><arg column="request_method" javaType="java.lang.String"/><arg column="request_path" javaType="java.lang.String"/><arg column="target_address" javaType="java.lang.String"/><arg column="call_status" javaType="java.lang.String"/><arg column="platform_code" javaType="java.lang.String"/><arg column="http_status" javaType="int"/><arg column="duration_ms" javaType="long"/><arg column="request_headers" javaType="java.lang.String"/><arg column="request_summary" javaType="java.lang.String"/><arg column="response_headers" javaType="java.lang.String"/><arg column="response_summary" javaType="java.lang.String"/><arg column="error_message" javaType="java.lang.String"/><arg column="call_time" javaType="java.time.LocalDateTime"/><arg column="completed_at" javaType="java.time.LocalDateTime"/></constructor>
    </resultMap>
    <insert id="insert">
        insert into ip_invocation_log(trace_id, route_type, interface_code, interface_name, caller, target_system, request_method, request_path, target_address, call_status, platform_code, http_status, duration_ms, request_headers, request_summary, response_headers, response_summary, error_message, call_time, completed_at)
        values (#{value.traceId}, #{value.routeType}, #{value.interfaceCode}, #{value.interfaceName}, #{value.caller}, #{value.targetSystem}, #{value.requestMethod}, #{value.requestPath}, #{value.targetAddress}, #{value.callStatus}, #{value.platformCode}, #{value.httpStatus}, #{value.durationMs}, #{value.requestHeaders}, #{value.requestSummary}, #{value.responseHeaders}, #{value.responseSummary}, #{value.errorMessage}, #{value.callTime}, #{value.completedAt})
    </insert>
    <select id="findRecent" resultMap="summary">
        select trace_id, route_type, interface_code, interface_name, caller, target_system, request_method, request_path, call_status, platform_code, http_status, duration_ms, call_time from ip_invocation_log order by call_time desc limit #{limit}
    </select>
    <select id="findByTraceId" resultMap="detail">select * from ip_invocation_log where trace_id = #{traceId}</select>
</mapper>
