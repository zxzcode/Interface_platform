<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lzcer.interfaceplatform.mapper.ApiClientMapper">
 <resultMap id="client" type="com.lzcer.interfaceplatform.mapper.ApiClientMapper$ClientRow"><constructor><idArg column="id" javaType="long"/><arg column="client_code"/><arg column="client_name"/><arg column="app_key"/><arg column="enabled" javaType="boolean"/><arg column="created_at" javaType="java.time.LocalDateTime"/><arg column="updated_at" javaType="java.time.LocalDateTime"/></constructor></resultMap>
 <resultMap id="permission" type="com.lzcer.interfaceplatform.service.ApiClientService$Permission"><constructor><arg column="route_type"/><arg column="resource_code"/></constructor></resultMap>
 <resultMap id="secret" type="com.lzcer.interfaceplatform.mapper.ApiClientMapper$SecretRow"><constructor><idArg column="id" javaType="long"/><arg column="client_code"/><arg column="client_name"/><arg column="app_key"/><arg column="encrypted_app_secret"/></constructor></resultMap>
 <sql id="clientColumns">id, client_code, client_name, app_key, enabled, created_at, updated_at</sql>
 <select id="findAll" resultMap="client">select <include refid="clientColumns"/> from ip_api_client order by updated_at desc</select>
 <select id="findById" resultMap="client">select <include refid="clientColumns"/> from ip_api_client where id=#{id}</select>
 <select id="findByAppKey" resultMap="client">select <include refid="clientColumns"/> from ip_api_client where app_key=#{appKey}</select>
 <select id="findEnabledSecretByAppKey" resultMap="secret">select id, client_code, client_name, app_key, encrypted_app_secret from ip_api_client where app_key=#{appKey} and enabled=true</select>
 <select id="findPermissions" resultMap="permission">select route_type, resource_code from ip_client_permission where client_id=#{clientId} order by route_type, resource_code</select>
 <insert id="insert">insert into ip_api_client(client_code,client_name,app_key,encrypted_app_secret,enabled) values(#{code},#{name},#{appKey},#{secret},#{enabled})</insert>
 <update id="update">update ip_api_client set client_name=#{name}, enabled=#{enabled}, updated_at=current_timestamp where id=#{id}</update>
 <update id="updateSecret">update ip_api_client set encrypted_app_secret=#{secret}, updated_at=current_timestamp where id=#{id}</update>
 <delete id="delete">delete from ip_api_client where id=#{id}</delete>
 <select id="countPermission" resultType="long">select count(*) from ip_client_permission where client_id=#{clientId} and route_type=#{routeType} and resource_code=#{resourceCode}</select>
 <select id="countResource" resultType="long">select count(*) from <choose><when test="routeType == 'HTTP'">ip_interface where interface_code=#{code}</when><otherwise>ip_sql_api where api_code=#{code}</otherwise></choose></select>
 <delete id="deletePermissions">delete from ip_client_permission where client_id=#{clientId}</delete>
 <insert id="insertPermission">insert into ip_client_permission(client_id,route_type,resource_code) values(#{clientId},#{routeType},#{resourceCode})</insert>
</mapper>
